# Copia este archivo como `.env` y ajusta los valores.

PORT=4000

# --- Motor de base de datos --------------------------------------------
# DB_CLIENT decide qué usar. Si lo dejas sin definir: SQLite en local/develop
# (NODE_ENV distinto de "production"), Postgres en producción.
#
#   sqlite    (recomendado para desarrollo local): no instala nada, no
#             necesita Docker. Se crea solo en database/smokesoft.sqlite la
#             primera vez que corres `npm run seed`.
#   postgres  : usa las variables DB_* de abajo. Necesitas Postgres corriendo
#               (por ejemplo `docker compose up -d` desde la raíz del repo).
#
# DB_CLIENT=sqlite

# Variables solo necesarias con DB_CLIENT=postgres (coinciden con
# docker-compose.yml en la raíz del repo):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smokesoft
DB_USER=postgres
DB_PASSWORD=admin321

# Firma de los tokens. GENERA UNO PROPIO, no uses este texto:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h
